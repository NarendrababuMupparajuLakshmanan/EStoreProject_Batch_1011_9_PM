@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreAdminModel.Models.Types;
@model CreateTypeModel;
<html>
<head>
    <title>Create Type</title>
    <link href="~/Bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>
    <div class="container">
        <div class="row mt-3 col-lg-8 mx-auto border-1 p-3 border-dark-subtle">
            <div class="row mt-3">
                <div class="h1 text-center bg-primary">
                    Create Type
                </div>
            </div>

            <form method="post">

                <div class="row mt-3">
                    <div class="col-lg-4 col-md-4 col-sm-4">
                        <label asp-for="Name">Type Name</label>
                    </div>
                    <div class="col-lg-5 col-md-5 col-sm-5">
                        <input type="text" class="form-control" asp-for="Name" />
                        <span asp-validation-for="Name" class="text-danger" ></span>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-4 col-md-4 col-sm-4">
                        <a class="btn btn-secondary">Cancel</a>
                    </div>
                    <div class="col-lg-4 col-md-4 col-sm-4">
                        <button class="btn btn-primary"
                                asp-controller="Type"
                                asp-action="CreateType">
                            Submit
                        </button>
                    </div>
                </div>
            </form>

         
        </div>

    </div>
</body>
</html>