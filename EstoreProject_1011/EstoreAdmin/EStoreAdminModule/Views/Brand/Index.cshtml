@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using EstoreAdminModel.Models.Brands;
@model List<BrandModel>

<html>
<head>
    <title>List of Brands</title>
    <link href="~/Bootstrap/css/bootstrap.css" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="row mt-3">
            <div class="h1 text-center bg-primary">
                List of Brands
            </div>
        </div>

        <div class="row mt-3">
            <div class="col-lg-3 col-md-3 col-sm-3">
                <a class="btn btn-primary" 
                    asp-controller="Brand" 
                    asp-action="CreateBrand">
                    New Brand
                </a>
            </div>
        </div>

        <div class="row mt-3">
            <table class="table table-primary table-hover">
                <thead>
                    <tr>
                        <td>Brand Id</td>
                        <td>Brand Name</td>
                        <td>Edit</td>
                        <td>Delete</td>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || Model.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center h1">No Brands Found</td>
                        </tr>

                    }
                    else
                    {
                    @foreach (BrandModel brandModel in Model)
                    {
                        <tr>
                            <td>@brandModel.Id</td>
                            <td>@brandModel.Name</td>
                                <td>
                                    <a class="btn btn-outline-secondary"
                                       asp-controller="Brand"
                                       asp-action="EditBrand"
                                       asp-route-Id="@brandModel.Id">Edit</a>
                                </td>
                            <td>
                                <a class="btn btn-outline-danger"
                                   asp-controller="Brand"
                                   asp-action="DeleteBrand"
                                   asp-route-Id="@brandModel.Id">Delete</a>
                            </td>
                        </tr>
                    }

                    }

                </tbody>
            </table>
        </div>
    </div>

        

     


        
</body>
</html>